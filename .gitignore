.venv/
.venv-1/
.env
# 外部資産の場所の設定（研究室の参照ライブラリのパスが入る）。雛形は lipidmix.example.toml
lipidmix.local.toml
data/
.vs/
.vscode/
bin/
# docs/ は丸ごと無視せず、ランタイム必須の output_format.md やスキーマ docs は
# 共有する。開発ログだけ個別に除外する（別の場所へ配備したときに欠落させないため）。
docs/HISTRY.md
docs/task.md
# ポスター準備の作業資材（未発表）。図・zip も含めて公開リポには載せない。
docs/poster/
__pycache__/
obj/
photos/
workspace/
debug/
/analysis/
# analyses/ と knowledge/ はセッション毎に育つ蓄積物なので、既に追跡済みの
# 種ノート以外は追跡しない（gitignore は追跡済みファイルには影響しない）。
# playbook/ は版管理された再利用手順で、GATEWAY 手順2 (lipidmix://playbook/index)
# が参照する。ここに挙げると**新規**の playbook ノートが無言で追跡漏れするため外す。
analyses/
knowledge/
.check.py
*.pyc
*.pyo
*.pyd
*.log
# 追跡済みの requirements.txt 等は影響を受けないが、新規の .txt は
# 明示的に git add -f しない限り無視される点に注意。
*.txt
*.csproj
*.sln
interp_eval_out/
# 解釈精度評価アウトプット（archives/ 退避後の新パス）
archives/interp_eval/out/
# 退避物置き場。既に追跡済みの archives/interp_eval/ 配下は追跡が継続する。
archives/

# Subagent-Driven Development の作業台帳・レビュー資材（スクラッチ）
.superpowers/

# エージェントごとの隔離作業ツリー（scripts/new-worktree.sh が作る）。中身は
# 別ブランチのチェックアウトそのものなので、git add -A で丸ごと巻き込まない。
.worktrees/

# ローカル専用の調査メモ。docs/task.md が出典として参照するので消さないが、
# 追跡もしない（2026-09-15 の SDD CONSTRAINTS で「削除・stash しない」と
# 決めた未追跡物をそのまま保つ）。
docs/research/

# 参照ライブラリとその照合用キャッシュ。研究室の参照ライブラリ（.msp）は外部流出
# 禁止の資産で、本体は環境変数 MSDIAL_MSP_POS / MSDIAL_MSP_NEG でリポジトリの外を
# 指す。store のキャッシュ（SQLite）と sha256 の対応表はその完全な写し／置き場所を
# 含むので、LIPIDMIX_LIBRARY_CACHE_DIR を data/ の外へ向けても置き場所を問わず
# 追跡しない。tests/test_gitignore_library.py がこの網を縛っている。
*.msp
*.msp2
*.dbs
*.lbm
*.lbm2
*.sqlite
.library-cache/
.library-digests.json
