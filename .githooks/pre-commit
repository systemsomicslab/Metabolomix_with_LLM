#!/bin/sh
# コミット前に全テストを通す。
#
# 所要時間は全テストの実行時間そのもので、数分かかる。エージェントが回す場合、
# 既定のコマンドタイムアウトを超えるのでコミットはバックグラウンド実行にすること。
#
# なぜフックなのか: 腐敗防止テストは揃っているが、CI が無く「誰かが走らせるはず」に
# 依存していた。複数のエージェントを並列で走らせている以上、実行を人／モデルの
# 記憶に任せると必ず取りこぼす。git 側に置けばエージェントの種類を問わず効く。
#
# 意図的にやらないこと: ステージ内容だけを検証するための stash はしない。
# 並列で別のエージェントが同じ作業ツリーを触っているとき、stash は他人の
# 未コミット変更を巻き込んで消しうる。作業ツリーそのものを検証する。
#
# 緊急時の迂回: git commit --no-verify
set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# 解釈系: 自ツリーの .venv → main ツリーの .venv（worktree は自前の .venv を持たない）
# → 従来の C:/Python314 → PATH の python（spec 2026-10-15）。
main=$(cd "$(dirname "$(git rev-parse --git-common-dir)")" && pwd)
PY=""
for candidate in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python" \
                 "$main/.venv/Scripts/python.exe" "$main/.venv/bin/python" \
                 C:/Python314/python.exe; do
    if [ -f "$candidate" ]; then PY=$candidate; break; fi
done
[ -n "$PY" ] || PY=python
echo "pre-commit: interpreter $PY"

echo "pre-commit: pytest tests -q"
if ! "$PY" -m pytest tests -q; then
    echo ""
    echo "pre-commit: テストが落ちたためコミットを中止した。"
    echo "  直してから再実行する。迂回が必要なときだけ: git commit --no-verify"
    exit 1
fi
