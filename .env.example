# Copy values into your MCP client env block or local shell.
# Keep the MCP server local.

LIPIDMIX_DATA_DIR=C:\path\to\msdial\output

# 蓄積ノートの置き場の上書き（未設定時は <project>/knowledge）
# LIPIDMIX_KNOWLEDGE_DIR=C:\path\to\lipidmix\knowledge

# レポート/図の退避先（解析フォルダが書き込み不可のとき使用。未設定時は <project>/reports）
# LIPIDMIX_REPORTS_DIR=C:\path\to\reports

# Leave unset for local stdio MCP.
# LIPIDMIX_TRANSPORT=stdio
